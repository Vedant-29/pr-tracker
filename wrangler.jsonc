{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-tracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Every request goes through the worker first so the auth gate can guard
    // the page itself, not just the API.
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  // Create with `pnpm exec wrangler kv namespace create CACHE` and paste the id.
  // Local dev works with the placeholder.
  "kv_namespaces": [{ "binding": "CACHE", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }],
  // Keeps the KV cache warm so a page open never waits on GitHub.
  "triggers": { "crons": ["*/10 * * * *"] },
  // To serve it on your own domain, add:
  // "routes": [{ "pattern": "prs.example.com", "custom_domain": true }],
  "vars": {
    // Comma-separated "login:token-var" pairs; the tokens live in secrets.
    // Example for two accounts: "octocat:GITHUB_TOKEN_1,octocat-work:GITHUB_TOKEN_2"
    "ACCOUNTS": "your-github-login:GITHUB_TOKEN_1"
  }
}
